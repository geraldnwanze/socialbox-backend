NODE_ENV=development
PORT=3001

APP_URL=http://localhost:3000
API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000

# Postgres (run via docker-compose — do not install Postgres on the host)
DATABASE_URL=postgres://socialbox:socialbox@localhost:5432/socialbox

# Redis (run via docker-compose — do not install Redis on the host)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_REFRESH_TTL=30d

# Encryption key for channel OAuth credentials at rest (32-byte key, base64)
CREDENTIALS_ENCRYPTION_KEY=

# Sentry
SENTRY_DSN=

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=socialbox-media
R2_ENDPOINT=

# WhatsApp Cloud API
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Facebook Messenger / Instagram (shared Meta app)
META_APP_SECRET=
META_VERIFY_TOKEN=
META_API_VERSION=v21.0
